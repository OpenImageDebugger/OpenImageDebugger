{
  "$schema": "https://raw.githubusercontent.com/OpenImageDebugger/OpenImageDebugger/main/resources/schemas/oid-types-v1.json",
  "version": 1,
  "types": [
    {
      "name": "cv::Mat",
      "match": "^(?:const\\s+)?cv::Mat_?(?:<[^>]{1,32}>)?(?:\\s*[*&])?$",
      "pointer": "{sym}.data",
      "width": "{sym}.cols",
      "height": "{sym}.rows",
      "channels": { "if":   "((({sym}.flags & 4088) >> 3) + 1) <= 4",
                    "then": "(({sym}.flags & 4088) >> 3) + 1",
                    "else": "(({sym}.flags & 4064) >> 5) + 1" },
      "dtype": "{sym}.flags & 7",
      "row_stride": "{sym}.step.p[0] / {channels} / {elemsize}",
      "pixel_layout": { "if": "{channels} >= 3", "then": "bgra", "else": "rgba" }
    },
    {
      "name": "CvMat",
      "match": "^(?:const\\s+)?CvMat(?:\\s*[*&])?$",
      "pointer": { "first_valid": ["{sym}.data.ptr", "{sym}.data"] },
      "width": "{sym}.cols",
      "height": "{sym}.rows",
      "channels": { "if":   "((({sym}.type & 4088) >> 3) + 1) <= 4",
                    "then": "(({sym}.type & 4088) >> 3) + 1",
                    "else": "(({sym}.type & 4064) >> 5) + 1" },
      "dtype": "{sym}.type & 7",
      "row_stride": "{sym}.step / {channels} / {elemsize}",
      "pixel_layout": { "if": "{channels} >= 3", "then": "bgra", "else": "rgba" }
    },
    {
      "name": "IplImage",
      "match": "^(?:const\\s+)?IplImage(?:\\s*[*&])?$",
      "pointer": "{sym}.imageData",
      "width": "{sym}.width",
      "height": "{sym}.height",
      "channels": "{sym}.nChannels",
      "dtype": { "expr": "{sym}.depth & 0xffffffff",
                 "map": { "8": "uint8", "2147483656": "uint8",
                          "16": "uint16", "2147483664": "int16",
                          "32": "float32", "64": "float64" } },
      "row_stride": "{sym}.widthStep / {channels} / {elemsize}",
      "pixel_layout": { "if": "{channels} >= 3", "then": "bgra", "else": "rgba" }
    },
    {
      "name": "Eigen::Matrix",
      "match": "^(?:const\\s+)?Eigen::Matrix<",
      "dtype": "{targ:0}",
      "transpose": "({targ:3} & 1) == 0",
      "width":  { "if": "{transpose}",
        "then": { "first_valid": [ { "expr": "{targ:1}", "min": 1 }, "{sym}.m_storage.m_rows" ] },
        "else": { "first_valid": [ { "expr": "{targ:2}", "min": 1 }, "{sym}.m_storage.m_cols" ] } },
      "height": { "if": "{transpose}",
        "then": { "first_valid": [ { "expr": "{targ:2}", "min": 1 }, "{sym}.m_storage.m_cols" ] },
        "else": { "first_valid": [ { "expr": "{targ:1}", "min": 1 }, "{sym}.m_storage.m_rows" ] } },
      "pointer": { "first_valid": [ "{sym}.m_storage.m_data.array", "{sym}.m_storage.m_data" ] },
      "row_stride": "{width}",
      "pixel_layout": "rgba"
    },
    {
      "name": "Eigen::Map",
      "match": "^(?:const\\s+)?Eigen::Map<",
      "display_name": "{name} ({targ:0})",
      "dtype": "{targ:0.0}",
      "transpose": "({targ:0.3} & 1) == 0",
      "width":  { "if": "{transpose}",
        "then": { "first_valid": [ { "expr": "{targ:0.1}", "min": 1 }, "{sym}.m_rows.m_value" ] },
        "else": { "first_valid": [ { "expr": "{targ:0.2}", "min": 1 }, "{sym}.m_cols.m_value" ] } },
      "height": { "if": "{transpose}",
        "then": { "first_valid": [ { "expr": "{targ:0.2}", "min": 1 }, "{sym}.m_cols.m_value" ] },
        "else": { "first_valid": [ { "expr": "{targ:0.1}", "min": 1 }, "{sym}.m_rows.m_value" ] } },
      "pointer": "{sym}.m_data",
      "row_stride": { "first_valid": [ { "expr": "{sym}.m_stride.m_outer.m_value", "min": 1 }, "{width}" ] },
      "pixel_layout": "rgba"
    }
  ]
}
